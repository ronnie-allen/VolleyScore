    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.1",
